# Backend origin (the app talks to it via the same-origin /api/v1/ proxy).
VITE_SERVER_URL=https://app.isourceplus.net/

# Frontend's own public origin (used in outbound copy such as SMS sign-up links).
VITE_APP_URL=https://isourceplus.com

# Notification WebSocket origin. Leave unset locally (Vite proxies /ws).
# On Vercel, which can't proxy WebSockets, set it to the backend:
# VITE_WS_URL=wss://app.isourceplus.net

# Pre-launch lockdown. ON by default in production builds — only the landing
# page and /waitlist are reachable; login, signup, dashboard, etc. redirect to
# the landing page. Set to false in the Vercel environment at launch to open the
# full app. Set to true in local dev to preview the locked-down site.
VITE_PRELAUNCH=false

# Server-side only (api/proxy.js on Vercel, server.js on Node): the backend the
# /api proxy forwards to. Defaults to https://app.isourceplus.net.
# API_TARGET=https://app.isourceplus.net
