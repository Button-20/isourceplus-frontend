# Backend origin (the app talks to it via the same-origin /api/v1/ proxy).
VITE_SERVER_URL=https://app.isourceplus.net/

# Pre-launch lockdown. ON by default in production builds — only the landing
# page and /waitlist are reachable; login, signup, dashboard, etc. redirect to
# the landing page. Set to false in the Render environment at launch to open the
# full app. Set to true in local dev to preview the locked-down site.
VITE_PRELAUNCH=false
